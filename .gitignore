# Git Ignore Specification for PetSpot Project

# Node.js & Frontend Dependencies
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.vite/

# Java & Gradle Build Artifacts
backend/.gradle/
backend/build/
backend/out/
backend/bin/
backend/.settings/
backend/.classpath
backend/.project

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
