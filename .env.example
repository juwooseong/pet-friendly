# docker-compose.yml 용 환경변수 예시. 이 파일을 .env 로 복사해 실제 값을 채운다.
# .env 는 .gitignore 대상이므로 커밋되지 않는다.

# DB (컨테이너 PostgreSQL)
DB_USERNAME=petspot
DB_PASSWORD=change-me
DB_PORT=5433

# JWT 서명 키 (32바이트 이상 임의 문자열)
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes

# 한국관광공사 TourAPI 서비스키 (data.go.kr, Decoding 키)
TOUR_API_SERVICE_KEY=

# 메일 발송 (비밀번호 찾기). 비워 두면 발송 실패
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 비밀번호 재설정 메일 링크에 넣을 사이트 주소 (기본 http://localtest.me)
FRONTEND_BASE_URL=http://localtest.me

# Kakao Maps JavaScript 키 (프런트 빌드 시 포함됨)
VITE_KAKAO_MAP_APP_KEY=

# 호스트에 노출할 포트
WEB_PORT=80
API_PORT=8081
REDIS_PORT=6379
